{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "packages/tranyx_web/firestore.indexes.json"
  },
  "hosting": {
    "public": "packages/tranyx_web/build/jaspr",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}