rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the user is accessing their own document or matches the user ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to check if the user is an admin, staff member, or registered P2P agent
    function isAdminOrStaff() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let hasUserDoc = exists(userPath);
      let userDoc = hasUserDoc ? get(userPath).data : {};
      
      let agentPath = /databases/$(database)/documents/p2p_agents/$(request.auth.uid);
      let isAgent = exists(agentPath);

      return isAuthenticated() && (
        isAgent ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('.*\\.(agents|agent|admin|staff)@tranyx\\.(app|com|ph)$') ||
          request.auth.token.email.matches('.*@(admin|staff|agents|agent)\\.tranyx\\.(app|com|ph)$') ||
          request.auth.token.email.matches('.*@(tranyx\\.app|tranyx\\.ph|tranyx\\.com|terra\\.app)$')
        )) ||
        (request.auth.token != null && (
          ('admin' in request.auth.token && request.auth.token.admin == true) ||
          ('role' in request.auth.token && (
            request.auth.token.role == 'admin' ||
            request.auth.token.role == 'staff' ||
            request.auth.token.role == 'agent'
          ))
        )) ||
        (hasUserDoc && (
          ('isAdmin' in userDoc && userDoc.isAdmin == true) ||
          ('role' in userDoc && (
            userDoc.role == 'admin' ||
            userDoc.role == 'staff' ||
            userDoc.role == 'support' ||
            userDoc.role == 'agent' ||
            userDoc.role == 'p2p_agent' ||
            userDoc.role == 'ADMIN' ||
            userDoc.role == 'STAFF' ||
            userDoc.role == 'AGENT'
          ))
        ))
      );
    }

    // Helper to check if a user is currently banned or suspended.
    function isUserBlocked(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      let docExists = exists(path);
      let userDoc = docExists ? get(path).data : {};
      return docExists && (
        ('banned' in userDoc && userDoc.banned == true) ||
        ('suspendedUntil' in userDoc && userDoc.suspendedUntil is int && userDoc.suspendedUntil > request.time.toMillis())
      );
    }

    // Helper to check if current request user is authenticated and NOT blocked
    function isActiveUser() {
      return isAuthenticated() && !isUserBlocked(request.auth.uid);
    }

    // Users Collection (Option 1: Strict segregation of User vs Admin fields)
    match /users/{userId} {
      allow read: if true; // Publicly readable profiles (ratings/reviews)
      
      // On creation: Regular users can create their own profile document
      allow create: if (isOwner(userId) && !request.resource.data.keys().hasAny([
        'role', 'banned', 'suspendedUntil'
      ])) || isAdminOrStaff();

      allow update: if 
        // 1. Regular User: Can update own profile fields (cannot alter admin role, ban, or suspension status)
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'banned', 'suspendedUntil'
        ]))
        || 
        // 2. Admin / Staff: Can update admin, moderation & verification fields
        isAdminOrStaff();

      allow delete: if isAdminOrStaff();
      
      // User Reviews subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if isActiveUser() && request.resource.data.authorId == request.auth.uid;
      }

      // User Ledger subcollection
      match /ledger/{ledgerId} {
        allow read: if isOwner(userId) || isAdminOrStaff();
        allow write: if isOwner(userId) || isAdminOrStaff();
      }

      // User Transactions subcollection
      match /transactions/{txId} {
        allow read: if isOwner(userId) || isAdminOrStaff();
        allow write: if isOwner(userId) || isAdminOrStaff();
      }
    }

    // Jobs Collection (Anti-Exploitation Rules: Employer CANNOT update job details once active/hired)
    match /jobs/{jobId} {
      allow read: if true; // Publicly browse jobs
      allow create: if isActiveUser() && request.resource.data.creatorId == request.auth.uid;
      
      allow update: if 
        // 1. Creator (Employer): Can update listing details ONLY when job status is 'Open' / 'open' / 'Reviewing' / 'reviewing'
        // AND cannot alter once a Nyxian is accepted/hired unless through proper admin channels
        (isActiveUser() && resource.data.creatorId == request.auth.uid && 
          (resource.data.status == 'Open' || resource.data.status == 'open' || resource.data.status == 'Reviewing' || resource.data.status == 'reviewing') &&
          (!('acceptedApplicantId' in resource.data) || resource.data.acceptedApplicantId == null || resource.data.acceptedApplicantId == '') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'id', 'title', 'description', 'category', 'categoryGroup', 'employmentType', 
            'dateRequirement', 'jobDate', 'timePreference', 'pricingType', 'pricingValue', 
            'locationType', 'address', 'landmark', 'status', 'applicantCount', 
            'recentApplicantPhotos', 'applicantUids', 'pickupAddress', 'pickupLat', 
            'pickupLng', 'destinationAddress', 'destinationLat', 'destinationLng', 
            'hasTracker', 'hasInspectionHoldback', 'imageUrls', 'acceptedApplicantId', 
            'acceptedApplicantName', 'completionCode', 'receiptUrl', 'employerRated', 
            'nyxianRated', 'promoCode', 'discountAmount', 'creatorPhotoUrl', 
            'creatorName', 'creatorType', 'createdAt'
          ])
        ) ||
        // 1b. Creator (Employer): When job is completed/active, can ONLY submit employer rating (no editing pricing, addresses, requirements or unilateral cancelling!)
        (isActiveUser() && resource.data.creatorId == request.auth.uid && 
          resource.data.status != 'Open' && resource.data.status != 'open' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['employerRated'])
        ) ||
        // 2. Assigned Nyxian (Freelancer): Can update work progress, status & completion fields
        (isActiveUser() && 'acceptedApplicantId' in resource.data && resource.data.acceptedApplicantId == request.auth.uid && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'completionCode', 'receiptUrl', 'nyxianRated'
          ])
        ) ||
        // 3. Admin / Staff
        isAdminOrStaff();

      allow delete: if (isActiveUser() && resource.data.creatorId == request.auth.uid && (
        resource.data.status == 'Open' || 
        resource.data.status == 'open' || 
        resource.data.status == 'Cancelled' || 
        resource.data.status == 'cancelled'
      )) || isAdminOrStaff();

      // Subcollection: Applications
      match /applications/{applicantId} {
        allow read: if isAuthenticated();
        allow write: if isActiveUser() && (request.auth.uid == applicantId || resource.data.applicantId == request.auth.uid) || isAdminOrStaff();
      }

      // Subcollection: Messages (Chat room)
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow write: if isActiveUser() || isAdminOrStaff();
      }

      // Subcollection: Questions (Q&A)
      match /questions/{questionId} {
        allow read: if true;
        allow write: if isActiveUser();
      }
    }

    // Vehicle Rentals Collection (Anti-Exploitation Rules: Host CANNOT update vehicle/pricing once booked/active)
    match /rentals/{rentalId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.hostId == request.auth.uid;
      
      allow update: if 
        // 1. Host (Vehicle Owner): Can update vehicle/price details ONLY when status is 'Available' or 'available'
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          (resource.data.status == 'Available' || resource.data.status == 'available') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'brand', 'model', 'year', 'type', 'plateNumber', 'vehicleValue', 
            'ltoCrNumber', 'ltoOrNumber', 'insuranceProvider', 'insurancePolicyNumber', 
            'franchisePermit', 'interiorPhotoUrl', 'frontPhotoUrl', 'backPhotoUrl', 
            'contractType', 'contractTerms', 'price12h', 'priceDaily', 'priceWeekly', 
            'priceMonthly', 'extensionRatePerHour', 'latePenaltyRatePerHour', 'status', 
            'fuelType', 'transmission', 'offersDriver', 'driverDailyPrice', 'driverNote', 
            'driverLicenseNumber', 'renteeId', 'renteeName', 'renteePhotoUrl', 
            'renteePhone', 'renteeRating', 'startEpoch', 'endEpoch', 'expectedReturnEpoch', 
            'deliveryType', 'deliveryAddress', 'deliveryFee', 'currentLocationLat', 
            'currentLocationLng', 'fuelLevel', 'odoMeter', 'pickupPhotos', 
            'dropoffPhotos', 'hostRated', 'renteeRated'
          ])
        ) ||
        // 1b. Host (Vehicle Owner): When vehicle is active/booked, can ONLY submit host rating (no altering pricing or terms mid-rental!)
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          resource.data.status != 'Available' && resource.data.status != 'available' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostRated'])
        ) ||
        // 2. Assigned Rentee / Nyxian: Can update trip status, return info & location tracking
        (isActiveUser() && 'renteeId' in resource.data && resource.data.renteeId == request.auth.uid && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'currentLocationLat', 'currentLocationLng', 'fuelLevel', 
            'odoMeter', 'dropoffPhotos', 'renteeRated'
          ])
        ) ||
        // 3. Admin / Staff
        isAdminOrStaff();

      allow delete: if (isActiveUser() && resource.data.hostId == request.auth.uid && (resource.data.status == 'Available' || resource.data.status == 'available')) || isAdminOrStaff();

      match /questions/{questionId} {
        allow read: if true;
        allow write: if isActiveUser();
      }
    }

    // Properties Collection (Anti-Exploitation Rules: Host CANNOT update property/pricing once booked/active)
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.hostId == request.auth.uid;
      
      allow update: if 
        // 1. Host (Property Owner): Can update property details ONLY when status is 'Available' or 'available'
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          (resource.data.status == 'Available' || resource.data.status == 'available') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'description', 'propertyType', 'address', 'landmark', 
            'lat', 'lng', 'bedrooms', 'bathrooms', 'maxGuests', 'nightlyPrice', 
            'weeklyDiscount', 'monthlyDiscount', 'cleaningFee', 'depositAmount', 
            'amenities', 'houseRules', 'images', 'contractType', 'contractTerms', 
            'status', 'renteeId', 'renteeName', 'renteePhotoUrl', 'checkInDate', 
            'checkOutDate', 'hostRated', 'renteeRated'
          ])
        ) ||
        // 1b. Host (Property Owner): When property is active/booked, can ONLY submit host rating (no altering pricing or rules mid-booking!)
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          resource.data.status != 'Available' && resource.data.status != 'available' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostRated'])
        ) ||
        // 2. Assigned Rentee / Nyxian: Can update booking status & guest rating
        (isActiveUser() && 'renteeId' in resource.data && resource.data.renteeId == request.auth.uid && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'renteeRated'
          ])
        ) ||
        // 3. Admin / Staff
        isAdminOrStaff();

      allow delete: if (isActiveUser() && resource.data.hostId == request.auth.uid && (resource.data.status == 'Available' || resource.data.status == 'available')) || isAdminOrStaff();

      match /questions/{questionId} {
        allow read: if true;
        allow write: if isActiveUser();
      }
    }

    // Transactions Collection
    match /transactions/{txId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow create: if isAdminOrStaff() || (isActiveUser() && request.resource.data.uid == request.auth.uid && !request.resource.data.type.matches('^(payout|rebate|fee_deduction)$'));
      allow update: if isAdminOrStaff() || (isActiveUser() && resource.data.uid == request.auth.uid);
      allow delete: if isAdminOrStaff();
    }

    // Deposit Requests Collection (P2P Top-up Matching & Verification)
    match /deposit_requests/{reqId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow update: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }

    // P2P Agents Collection (Publicly readable verified agent QR credentials)
    match /p2p_agents/{agentId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    // Deposit References & Claimed References Collections (Anti-duplicate lock for approved references)
    match /deposit_references/{refKey} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /claimed_references/{refKey} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /claimed_p2p_references/{refKey} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /claimedReferences/{refKey} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Wallets Collection (Unified wallet storage)
    match /wallets/{walletId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow write: if isOwner(walletId) || isAdminOrStaff();
    }

    // Audit Logs Collections (Admin & Deposit lifecycle tracking)
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow create, update: if isAuthenticated();
      allow delete: if isAdminOrStaff();
    }

    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow create, update: if isAuthenticated();
      allow delete: if isAdminOrStaff();
    }

    match /admin_audit_logs/{logId} {
      allow read, write: if isAdminOrStaff();
    }

    match /system_logs/{logId} {
      allow read, write: if isAdminOrStaff();
    }

    // Subscriptions Collection
    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow create: if isActiveUser() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Withdrawal Requests Collection
    match /withdrawalRequests/{requestId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow create: if isActiveUser() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read, update, delete: if isActiveUser() && (resource == null || !('uid' in resource.data) || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow create: if isActiveUser();
    }

    // Escrow Holdbacks Collection
    match /escrow_holdbacks/{holdbackId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.employerId == request.auth.uid || isAdminOrStaff());
      allow create, update: if isActiveUser() && (request.resource.data.uid == request.auth.uid || request.resource.data.employerId == request.auth.uid || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }

    // Rental Requests Collection
    match /rental_requests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() || isAdminOrStaff();
    }

    // Rental Extensions Collection
    match /rental_extensions/{extId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() || isAdminOrStaff();
    }

    // Rental History Collection
    match /rental_history/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() || isAdminOrStaff();
    }

    // Property History Collection
    match /property_history/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() || isAdminOrStaff();
    }

    // Property Requests Collection
    match /property_requests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() || isAdminOrStaff();
    }

    // KYC Submissions Collection
    match /kyc_submissions/{submissionId} {
      allow read: if isAuthenticated() && (request.auth.uid == submissionId || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow write: if (isActiveUser() && (request.auth.uid == submissionId)) || isAdminOrStaff();
    }

    // Escrow Collections (Job & Rental Escrows)
    match /escrow/{jobId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.creatorId == request.auth.uid || 
        resource.data.employerId == request.auth.uid || 
        resource.data.workerId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow create: if isActiveUser() && (
        request.resource.data.employerId == request.auth.uid || 
        request.resource.data.creatorId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow update: if isActiveUser() && (
        resource.data.employerId == request.auth.uid || 
        resource.data.creatorId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow delete: if (isActiveUser() && (
        resource.data.employerId == request.auth.uid || 
        resource.data.creatorId == request.auth.uid
      )) || isAdminOrStaff();
    }

    match /rental_escrows/{rentalId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.renterId == request.auth.uid || 
        resource.data.hostId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow create, update: if isActiveUser() && (
        request.resource.data.renterId == request.auth.uid || 
        request.resource.data.hostId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow delete: if (isActiveUser() && (
        resource.data.renterId == request.auth.uid || 
        resource.data.hostId == request.auth.uid
      )) || isAdminOrStaff();
    }

    match /rental_extension_escrows/{extensionId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.renterId == request.auth.uid || 
        resource.data.hostId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow create, update: if isActiveUser() && (
        request.resource.data.renterId == request.auth.uid || 
        request.resource.data.hostId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow delete: if (isActiveUser() && (
        resource.data.renterId == request.auth.uid || 
        resource.data.hostId == request.auth.uid
      )) || isAdminOrStaff();
    }

    match /property_escrows/{requestId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.renterId == request.auth.uid || 
        resource.data.hostId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow create, update: if isActiveUser() && (
        request.resource.data.renterId == request.auth.uid || 
        request.resource.data.hostId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow delete: if (isActiveUser() && (
        resource.data.renterId == request.auth.uid || 
        resource.data.hostId == request.auth.uid
      )) || isAdminOrStaff();
    }

    // Wallet Links Collection
    match /walletLinks/{walletPublicKey} {
      allow read: if true;
      allow write: if isActiveUser() && request.resource.data.uid == request.auth.uid;
    }

    // Config Collection (app-level public config)
    match /config/app_config {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // System Config Collection (treasury key and backend config - Admin only!)
    match /system_config/{docId} {
      allow read, write: if isAdminOrStaff();
    }

    // Chats Collection
    match /chats/{chatId} {
      allow read, write: if isActiveUser() || isAdminOrStaff();
      match /messages/{messageId} {
        allow read, write: if isActiveUser() || isAdminOrStaff();
      }
    }

    // Support Chats Collection
    match /support_chats/{chatId} {
      allow read, write: if isActiveUser() || isAdminOrStaff();
      match /messages/{messageId} {
        allow read, write: if isActiveUser() || isAdminOrStaff();
      }
    }

    // Support Tickets Collection
    match /supportTickets/{ticketId} {
      allow read, write: if isActiveUser() || isAdminOrStaff();
    }

    // Disputes Collection (for Admin Portal review and resolution)
    match /disputes/{disputeId} {
      allow read, write: if isActiveUser() || isAdminOrStaff();
    }

    // Platform Fees Collection (Admin managed)
    match /platform_fees/{feeId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrStaff();
    }

    // Promos Collection
    match /promos/{promoId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdminOrStaff();
      allow update: if isAdminOrStaff() || 
        (isActiveUser() && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'usedBy']));
    }

    // News & Promotions Collection
    match /news_posts/{postId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    // Job Cancellation Audit Logs Collection
    match /job_cancellation_logs/{logId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.cancelledBy == request.auth.uid ||
        isAdminOrStaff()
      );
      allow create: if isActiveUser() && (
        request.resource.data.cancelledBy == request.auth.uid ||
        isAdminOrStaff()
      );
      allow update, delete: if isAdminOrStaff();
    }

    // Points History Collection
    match /points_history/{historyId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow write: if isActiveUser() && request.resource.data.uid == request.auth.uid;
    }

    // Collection Group rules
    match /{path=**}/applications/{applicantId} {
      allow read, write: if isActiveUser() || isAdminOrStaff();
    }

    match /{path=**}/questions/{questionId} {
      allow read: if true;
      allow write: if isActiveUser();
    }
  }
}
