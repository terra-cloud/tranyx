    // ------------------------------------------------------------------------
    // ADMINISTRATIVE & STAFF AUTHORIZATION HELPERS
    // ------------------------------------------------------------------------

    // Step 1: Zero-read instant verification via Auth Token Claims only. A staff-domain email alone grants
    // nothing (KAN-144): admin/staff access needs a custom claim set server-side.
    function isAdminTokenOrEmail() {
      return isAuthenticated() && (
        (request.auth.token != null && (
          ('admin' in request.auth.token && request.auth.token.admin == true) ||
          ('superadmin' in request.auth.token && request.auth.token.superadmin == true) ||
          ('role' in request.auth.token && (
            request.auth.token.role in [
              'admin', 'staff', 'support', 'agent', 'super_admin', 'superadmin',
              'ADMIN', 'STAFF', 'AGENT', 'SUPER_ADMIN'
            ]
          ))
        ))
      );
    }

    // Step 2: Lazy fallback check on /users/{uid} document
    function isUserAdminInDoc() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let userDoc = exists(userPath) ? get(userPath).data : {};
      return ('isAdmin' in userDoc && userDoc.isAdmin == true) ||
        ('isStaff' in userDoc && userDoc.isStaff == true) ||
        ('isSuperAdmin' in userDoc && userDoc.isSuperAdmin == true) ||
        ('isP2pAgent' in userDoc && userDoc.isP2pAgent == true) ||
        ('role' in userDoc && (
          userDoc.role in [
            'admin', 'staff', 'support', 'agent', 'p2p_agent', 'super_admin', 'superadmin',
            'ADMIN', 'STAFF', 'AGENT', 'SUPPORT', 'SUPER_ADMIN', 'SUPERADMIN'
          ]
        ));
    }

    // Step 3: Lazy check on /p2p_agents/{uid} document
    function isP2pAgentInDoc() {
      // Deactivated agents (isActive:false) lose desk access (KAN-136-B5).
      let path = /databases/$(database)/documents/p2p_agents/$(request.auth.uid);
      return exists(path) && get(path).data.get('isActive', false) == true;
    }

    // Desk access is a custom claim only. A client-written users doc or an active p2p_agents
    // doc does not grant it, and neither does the text of an email address.
    function isAdminOrStaff() {
      return isClaimStaff();
    }

    // Server-issued admin custom claim only. role=agent/staff, a users-doc flag, or an active
    // p2p_agents doc must not grant or edit privilege / paid-entitlement fields.
    function isClaimAdmin() {
      return isAuthenticated() && request.auth.token != null && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('superadmin' in request.auth.token && request.auth.token.superadmin == true) ||
        ('role' in request.auth.token && request.auth.token.role in [
          'admin', 'super_admin', 'superadmin', 'ADMIN', 'SUPER_ADMIN', 'SUPERADMIN'
        ])
      );
    }

    // Custom-claim staff/agent/admin. A users doc or an active p2p_agents doc is not this.
    // role=partner is not staff and is not in isAdminTokenOrEmail.
    function isClaimStaff() {
      return isAdminTokenOrEmail();
    }

    // City partner (TRAD-15). The claim is role=partner plus partnerId. It does not grant staff or admin.
    function isPartnerToken() {
      return isAuthenticated() && request.auth.token != null &&
        'role' in request.auth.token && request.auth.token.role == 'partner' &&
        'partnerId' in request.auth.token && request.auth.token.partnerId is string &&
        request.auth.token.partnerId.size() > 0;
    }

    // Identity Platform MFA puts the second factor on the token. A partner without it matches nothing.
    function partnerMfaOk() {
      return request.auth.token.keys().hasAny(['firebase']) &&
        request.auth.token.firebase.keys().hasAny(['sign_in_second_factor']) &&
        (request.auth.token.firebase.sign_in_second_factor == 'totp' ||
          request.auth.token.firebase.sign_in_second_factor == 'phone');
    }

    function partnerRecord() {
      return get(/databases/$(database)/documents/partners/$(request.auth.token.partnerId)).data;
    }

    function isActivePartner() {
      return isPartnerToken() && partnerMfaOk() &&
        exists(/databases/$(database)/documents/partners/$(request.auth.token.partnerId)) &&
        partnerRecord().get('status', '') == 'active' &&
        partnerRecord().get('uid', '') == request.auth.uid &&
        partnerRecord().get('renewalDate', 0) > request.time.toMillis();
    }

    // areaKey is the city or municipality slug. Listing and job location wins; user city is only a fallback in the revenue job.
    function partnerCoversArea(areaKey) {
      return isActivePartner() && areaKey is string && areaKey.size() > 0 &&
        areaKey in partnerRecord().get('areaKeys', []);
    }

    // Booking request party. renterId is the escrow alias of renteeId; uid/userId are older request shapes.
    function isBookingRequestParty(data) {
      return isAuthenticated() && (
        data.get('hostId', '') == request.auth.uid ||
        data.get('renteeId', '') == request.auth.uid ||
        data.get('renterId', '') == request.auth.uid ||
        data.get('uid', '') == request.auth.uid ||
        data.get('userId', '') == request.auth.uid
      );
    }

    // Claim-admin metadata touch only. Amount, status, and party fields stay on the money callables.
    function clientEscrowUpdateOk() {
      return isClaimAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'amount', 'status', 'employerFees', 'totalEscrowed', 'refundAmount', 'price', 'payout',
        'releasedAmount', 'releasedTo', 'refundedTo', 'employerId', 'creatorId', 'workerId',
        'nyxianId', 'hostId', 'renteeId', 'renterId', 'totalPaid', 'holdbackAmount'
      ]);
    }

