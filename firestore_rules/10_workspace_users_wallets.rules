    // ------------------------------------------------------------------------
    // WORKSPACE: USERS, WALLETS, TRANSACTIONS & FINANCES
    // ------------------------------------------------------------------------

    // Money record owner: the doc's uid or userId field is the caller.
    function ownsRecord(data) {
      return isAuthenticated() && (data.get('uid', '') == request.auth.uid || data.get('userId', '') == request.auth.uid);
    }

    // Owner edits to a withdrawal request after create. The owner only ever cancels (before an agent
    // claims it) or confirms receipt (once the agent sent proof, PENDING_CONFIRMATION -> APPROVED):
    // web firebase_service.dart cancelP2pWithdrawalRequest / confirmP2pWithdrawalCompleted, mobile
    // transit_repository.dart. Every owner write must be one of those two transitions, and each extra
    // field is pinned to it: p2pStatus mirrors the transition, balanceDeducted/refundedAt and
    // rejectionReason only on cancel (never re-arming a refund), adminUid only on confirm and only the
    // owner. verifiedAt (epoch ms, both apps write DateTime.now()) can't predate the request or sit more
    // than 5 minutes past request.time; cancel still sets it because shipped mobile/web clients do.
    // Everything else is admin/agent only.
    function isOwnerWithdrawalUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let next = request.resource.data;
      let from = resource.data.get('status', '');
      let to = next.get('status', '');
      let cancelling = changed.hasAny(['status']) && to == 'CANCELLED' && from in ['WAITING_FOR_AGENT', 'PENDING_REVIEW', 'PENDING'];
      let confirming = changed.hasAny(['status']) && to == 'APPROVED' && from == 'PENDING_CONFIRMATION';
      return ownsRecord(resource.data) && (cancelling || confirming) &&
        changed.hasOnly(['status', 'p2pStatus', 'balanceDeducted', 'refundedAt', 'rejectionReason', 'verifiedAt', 'updatedAt', 'adminUid']) &&
        (!changed.hasAny(['p2pStatus']) || next.p2pStatus == (cancelling ? 'CANCELLED' : 'COMPLETED')) &&
        (!changed.hasAny(['balanceDeducted', 'refundedAt']) || (cancelling && next.get('balanceDeducted', false) == false)) &&
        (!changed.hasAny(['rejectionReason']) || (cancelling && next.rejectionReason is string && next.rejectionReason.size() <= 500)) &&
        (!changed.hasAny(['adminUid']) || (confirming && next.adminUid == request.auth.uid)) &&
        (!changed.hasAny(['verifiedAt']) || (next.verifiedAt is number &&
          next.verifiedAt >= resource.data.get('createdAt', request.time.toMillis() - 300000) &&
          next.verifiedAt <= request.time.toMillis() + 300000));
    }

    // Job-derived global transaction ids (tranyx_app.dart completion flow): payout_nyx_<jobId> is the
    // worker's payout, fees_emp_<jobId> the employer's fees, and either party reads both by id.
    function isTxJobParticipant(txId) {
      let jobPath = /databases/$(database)/documents/jobs/$(txId.replace('^(payout_nyx|fees_emp)_', ''));
      return txId.matches('^(payout_nyx|fees_emp)_.+') && exists(jobPath) &&
        (get(jobPath).data.creatorId == request.auth.uid || get(jobPath).data.get('acceptedApplicantId', null) == request.auth.uid);
    }

    // Structured global transaction ids name the record they belong to, so their uid must be that
    // record's party (app writers: job completion payout_nyx_ = hired worker, fees_emp_ = employer;
    // cancel/delete refund_job_ / refund_stale_job_ = employer; deletePropertyRental refund_prop_ =
    // host; P2P p2p_dep_ / p2p_with_ = owner of the deposit / withdrawal request written just before).
    function isTxIdParty(txId, uid) {
      let jobPath = /databases/$(database)/documents/jobs/$(txId.replace('^(payout_nyx|fees_emp|refund_job|refund_stale_job)_', ''));
      let propPath = /databases/$(database)/documents/properties/$(txId.replace('^refund_prop_', ''));
      let depPath = /databases/$(database)/documents/deposit_requests/$(txId.replace('^p2p_dep_', ''));
      let wrPath = /databases/$(database)/documents/withdrawal_requests/$(txId.replace('^p2p_with_', ''));
      return
        (txId.matches('^payout_nyx_.+') && exists(jobPath) && get(jobPath).data.get('acceptedApplicantId', null) == uid) ||
        (txId.matches('^(fees_emp|refund_job|refund_stale_job)_.+') && exists(jobPath) && get(jobPath).data.creatorId == uid) ||
        (txId.matches('^refund_prop_.+') && exists(propPath) && get(propPath).data.hostId == uid) ||
        (txId.matches('^p2p_dep_.+') && exists(depPath) && get(depPath).data.get('uid', '') == uid) ||
        (txId.matches('^p2p_with_.+') && exists(wrPath) && get(wrPath).data.get('uid', '') == uid);
    }

    // KAN-136 stopgap (until KAN-126 Cloud Function ledger): hired worker may create
    // payout_nyx_<jobId> type=payout with amount bound to the job price. fees_emp_ /
    // platform_fees / employer-driven completion stay Function-only (P1/P2).
    function jobCompletionRatesOk(jobId, d) {
      let job = get(/databases/$(database)/documents/jobs/$(jobId)).data;
      let cfgPath = /databases/$(database)/documents/config/app_config;
      let cfg = exists(cfgPath) ? get(cfgPath).data : {};
      let commission = job.get('commissionRate', cfg.get('commissionRate', 0.03));
      let holdback = job.get('holdbackRate', cfg.get('holdbackRate', 0.10));
      return d.get('commissionRate', commission) == commission &&
        d.get('holdbackRate', holdback) == holdback;
    }
    // Payout create: if the worker user doc is credited in the same batch, the bump cannot exceed amount.
    function payoutCreditCapped(d) {
      let uPath = /databases/$(database)/documents/users/$(d.uid);
      return !exists(uPath) ||
        (getAfter(uPath).data.get('tyxBalance', 0) - get(uPath).data.get('tyxBalance', 0) <= d.amount + 0.0001);
    }
    // Amount bound to job price (KAN-136-D2): > 0 and <= pricingValue (holdback may lower the immediate payout).
    function payoutAmountBoundToJob(jobId, d) {
      let price = get(/databases/$(database)/documents/jobs/$(jobId)).data.get('pricingValue', 0);
      return price is number && price > 0 &&
        d.amount is number && d.amount > 0 && d.amount <= price &&
        d.get('baseAmount', price) == price;
    }
    function isJobCompletionTxCreate(txId) {
      let d = request.resource.data;
      let jobId = txId.replace('^payout_nyx_', '');
      let jobPath = /databases/$(database)/documents/jobs/$(jobId);
      return isActiveUser() &&
        txId.matches('^payout_nyx_.+') &&
        exists(jobPath) &&
        d.type == 'payout' &&
        d.uid == request.auth.uid &&
        get(jobPath).data.get('acceptedApplicantId', null) == request.auth.uid &&
        d.keys().hasAll(['uid', 'amount', 'status', 'type', 'createdAt']) &&
        d.status == 'Successful' &&
        payoutAmountBoundToJob(jobId, d) &&
        jobCompletionRatesOk(jobId, d) &&
        payoutCreditCapped(d);
    }

    // Users Collection (Strict segregation of User vs Admin fields)
    match /users/{userId} {
      allow read: if true; // Publicly readable profiles (ratings/reviews)
      
      // Regular users can create their profile without privileged fields (KAN-144: no role/staff/admin
      // flags and a zero starting balance; signup writes UserProfile.toMap(), which never sets them).
      // Staff (admin claim, or verified staff-domain email via isAdminOrStaff) can bootstrap administrative roles.
      allow create: if (
        (isOwner(userId) &&
          !request.resource.data.keys().hasAny([
            'role', 'banned', 'suspendedUntil', 'admin', 'isAdmin', 'isStaff', 'isSuperAdmin', 'isP2pAgent'
          ]) &&
          request.resource.data.get('tyxBalance', 0) == 0 &&
          request.resource.data.get('reservedBalance', 0) == 0) ||
        isAdminOrStaff()
      ) &&
      (!('tyxBalance' in request.resource.data) || (request.resource.data.tyxBalance is number && request.resource.data.tyxBalance >= 0));

      allow update: if (
        // 1. Regular User: Can update own profile fields (cannot alter admin role, ban, or suspension status)
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isAdmin', 'isStaff', 'isSuperAdmin', 'isP2pAgent', 'banned', 'suspendedUntil', 'rating', 'ratingCount'
        ]))
        || 
        // 2. Admin / Staff: Can update admin, moderation & verification fields
        isAdminOrStaff()
        ||
        // 3. Owner's own subscription fields (self-grant stays open until server-side activation: phase 2)
        (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isPremium', 'premiumUntil', 'accountType', 'subscriptionPlan', 
          'subscriptionStartedAt', 'subscriptionPaymentMethod', 'subscriptionPaymentAmount', 
          'subscriptionTxId', 'subscriptionStatus', 'pendingSubscription', 
          'lastSubscriptionRejection', 'updatedAt'
        ]))
        ||
        // 4. Inactive gig reclaim: Allow incrementing worker's abandonedJobs metric
        (isActiveUser() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['abandonedJobs']) &&
          request.resource.data.abandonedJobs is number &&
          (!('abandonedJobs' in resource.data) || request.resource.data.abandonedJobs == resource.data.abandonedJobs + 1)
        )
      ) &&
      (!('tyxBalance' in request.resource.data) || (request.resource.data.tyxBalance is number && request.resource.data.tyxBalance >= 0));

      allow delete: if isAdminOrStaff();
      
      // Legacy user reviews subcollection: read-only for clients. New ratings go to /ratings (KAN-145).
      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if isAdminOrStaff();
      }

      // User Ledger subcollection
      match /ledger/{ledgerId} {
        allow read, write: if isOwner(userId) || isAdminOrStaff();
      }

      // User Transactions subcollection
      match /transactions/{txId} {
        allow read, write: if isOwner(userId) || isAdminOrStaff();
      }

      // User Points subcollection
      match /points/{docId} {
        allow read, write: if isOwner(userId) || isAdminOrStaff();
      }
    }

    // Wallets Collection (Unified wallet storage & user ledger sub-collections)
    match /wallets/{walletId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.uid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow write: if (isOwner(walletId) || isAdminOrStaff()) &&
        (!('balance' in request.resource.data) || (request.resource.data.balance is number && request.resource.data.balance >= 0));

      match /transactions/{txId} {
        allow read, write: if isAuthenticated() && (walletId == request.auth.uid || isAdminOrStaff());
        allow delete: if isAdminOrStaff();
      }

      match /ledger/{entryDoc} {
        allow read, write: if isAuthenticated() && (walletId == request.auth.uid || isAdminOrStaff());
        allow delete: if isAdminOrStaff();
      }
    }

    // Wallet Links Collection: wallet address -> uid, one wallet per account. Wallet sign-in was
    // removed (KAN-124), so nothing reads this before sign-in. Get stays open to signed-in users for
    // the "already linked to another account" check; the same mapping is public on
    // users/{uid}.walletPublicKey. Docs hold uid + linkedAt only (no tokens or passwords), and only
    // the linked owner can re-write or delete one.
    match /walletLinks/{walletPublicKey} {
      allow get: if isAuthenticated();
      allow list: if isAdminOrStaff();
      allow create: if isActiveUser() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'linkedAt']);
      allow update: if isActiveUser() && resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid', 'linkedAt']);
      allow delete: if isAdminOrStaff() || (isActiveUser() && resource.data.uid == request.auth.uid);
    }

    // Global Transactions Collection
    match /transactions/{txId} {
      // get: owner, a participant of the job a payout_nyx_/fees_emp_ id names (only while the doc's
      // uid is still that job's worker/employer, so re-creating a deleted job id grants nothing), or
      // admin/agent. An id that doesn't exist yet is readable by any signed-in user (existence only):
      // the app's idempotency checks (existingTx, txNyxDoc/txEmpDoc, p2p_* lookups) read before writing.
      // Missing payout_nyx_/fees_emp_/refund_prop_ ids only by that job's participants / the host, so
      // denied-vs-missing can't be used to probe someone else's records.
      // list: owner only (getMyTransactions filters uid == caller).
      allow get: if isAuthenticated() &&
        ((resource == null && (!txId.matches('^(payout_nyx|fees_emp|refund_prop)_.*') ||
            isTxJobParticipant(txId) || isTxIdParty(txId, request.auth.uid))) ||
          (resource != null && ownsRecord(resource.data)) ||
          (isTxJobParticipant(txId) && isTxIdParty(txId, resource.data.get('uid', ''))) || isAdminOrStaff());
      allow list: if isAdminOrStaff() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      // create: a structured id (see isTxIdParty) only by its own party, so nobody can squat a
      // public job / property / request id before the real writer.
      // KAN-136 stopgap: hired worker may create payout_nyx_<job> type=payout (amount bound to job price).
      allow create: if isAdminOrStaff() || isJobCompletionTxCreate(txId) || (isActiveUser() && request.resource.data.uid == request.auth.uid && !request.resource.data.type.matches('^(payout|rebate|fee_deduction)$') &&
        (!txId.matches('^(payout_nyx|fees_emp|refund_job|refund_stale_job|refund_prop|p2p)_.*') || isTxIdParty(txId, request.auth.uid)));
      // KAN-136-05: structured job/property/p2p tx ids are create-only for clients (no owner rewrite/replay).
      allow update: if isAdminOrStaff() || (isActiveUser() && resource.data.uid == request.auth.uid &&
        !txId.matches('^(payout_nyx|fees_emp|refund_job|refund_stale_job|refund_prop|p2p)_.*'));
      allow delete: if isAdminOrStaff();
    }

    // Subscriptions Collection (P2P Hybrid PRO Subscriptions)
    match /subscriptions/{subId} {
      allow read: if isAdminOrStaff() || ownsRecord(resource.data);
      allow create: if isAdminOrStaff() || (isAuthenticated() && request.resource.data.uid == request.auth.uid);
      allow update: if isAdminOrStaff();
      allow delete: if isAdminOrStaff();
    }

    // Deposit Requests Collections (Dual-collection sync: deposit_requests & depositRequests)
    match /deposit_requests/{reqId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow update: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }

    match /depositRequests/{requestId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow update: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }

    match /deposits/{depositId} {
      allow read: if isAdminOrStaff() || ownsRecord(resource.data);
      allow write: if isAdminOrStaff();
    }

    // Withdrawal Requests Collections (Dual-collection sync: withdrawal_requests & withdrawalRequests)
    match /withdrawal_requests/{reqId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow update: if isAdminOrStaff() || isOwnerWithdrawalUpdate();
      allow delete: if isAdminOrStaff();
    }

    match /withdrawalRequests/{requestId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow update: if isAdminOrStaff() || isOwnerWithdrawalUpdate();
      allow delete: if isAdminOrStaff();
    }

    match /withdrawals/{requestId} {
      allow read: if isAdminOrStaff() || ownsRecord(resource.data);
      allow write: if isAdminOrStaff();
    }

    match /cashout_requests/{requestId} {
      allow read: if isAdminOrStaff() || ownsRecord(resource.data);
      allow write: if isAdminOrStaff();
    }

    // Deposit References & Claimed References Collections
    match /deposit_references/{refKey} {
      allow read: if isAdminOrStaff() || ownsRecord(resource.data);
      allow write: if isAdminOrStaff();
    }

    match /claimed_references/{refKey} {
      allow read: if isAdminOrStaff() || ownsRecord(resource.data);
      allow write: if isAdminOrStaff();
    }

    match /claimed_p2p_references/{refKey} {
      allow read: if isAdminOrStaff() || ownsRecord(resource.data);
      allow write: if isAdminOrStaff();
    }

    match /claimedReferences/{refKey} {
      allow read: if isAdminOrStaff() || ownsRecord(resource.data);
      allow write: if isAdminOrStaff();
    }

    // Points History Collection
    match /points_history/{historyId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow write: if (isActiveUser() && request.resource.data.uid == request.auth.uid) || isAdminOrStaff();
    }
