    // ------------------------------------------------------------------------
    // WORKSPACE: VEHICLE RENTALS & ESCROWS
    // ------------------------------------------------------------------------

    // Helper to validate vehicle rental pricing constraints
    function isValidVehiclePricing(data) {
      let priceDaily = ('priceDaily' in data && data.priceDaily is number) ? data.priceDaily : 0.0;
      let price12h = ('price12h' in data && data.price12h is number) ? data.price12h : 0.0;
      let priceWeekly = ('priceWeekly' in data && data.priceWeekly is number) ? data.priceWeekly : 0.0;
      let priceMonthly = ('priceMonthly' in data && data.priceMonthly is number) ? data.priceMonthly : 0.0;
      return priceDaily > 0.0 &&
        (price12h == 0.0 || (price12h >= priceDaily * 0.4 && price12h <= priceDaily)) &&
        (priceWeekly == 0.0 || (priceWeekly >= priceDaily * 3.5 && priceWeekly > priceDaily)) &&
        (priceMonthly == 0.0 || (priceMonthly >= priceDaily * 12.0 && (priceWeekly == 0.0 || priceMonthly > priceWeekly)));
    }

    // Helper to check if current user is the renter, rentee, or host of an escrow
    function isRentalEscrowParty(data) {
      return ('renterId' in data && data.renterId == request.auth.uid) || 
             ('renteeId' in data && data.renteeId == request.auth.uid) || 
             ('hostId' in data && data.hostId == request.auth.uid);
    }

    // Vehicle Rentals Collection (Anti-Exploitation: Host CANNOT alter pricing once booked)
    match /rentals/{rentalId} {
      // Public for everyone except a partner token, which only reads its own areaKey.
      allow read: if !isPartnerToken() || (resource != null && partnerCoversArea(resource.data.get('areaKey', '')));
      allow create: if isActiveUser() && request.resource.data.hostId == request.auth.uid &&
        isValidVehiclePricing(request.resource.data) && !hasExactListingLocation(request.resource.data);
      
      allow update: if !listingUpdateTouchesExactLocation() && (
        // 1. Host (Vehicle Owner): Can update vehicle/price details & accept bookings when not actively rented
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          request.resource.data.hostId == resource.data.hostId &&
          !(resource.data.status in ['Booked', 'Rented', 'On the way to Rentee', 'Returning', 'Active']) &&
          (request.resource.data.status in ['Available', 'available', 'Not Accepting Bookings', 'Awaiting Signature', 'awaiting signature'] ||
           request.resource.data.status == resource.data.status) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['priceDaily', 'price12h', 'priceWeekly', 'priceMonthly']) ||
           isValidVehiclePricing(request.resource.data)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            // Identity & metadata
            'id', 'hostName', 'hostPhotoUrl', 'acceptingBookings', 'status',
            'isListingFeeWaived', 'createdAt', 'updatedAt',
            // Vehicle specs
            'brand', 'model', 'vehicleModel', 'year', 'type', 'vehicleType',
            'plateNumber', 'transmission', 'fuelType', 'seatingCapacity',
            'mileageLimitPerDay', 'minDriverAge', 'fuelPolicy', 'description', 'features',
            // Pricing & deposit
            'price12h', 'hourlyRate', 'priceDaily', 'PricePerDay', 'pricePerDay',
            'priceWeekly', 'weeklyRate', 'priceMonthly', 'monthlyRate',
            'allowedDurations', 'extensionRatePerHour', 'latePenaltyRatePerHour',
            'vehicleValue', 'securityDeposit', 'depositType', 'depositValue',
            'securityDepositPolicy',
            // Location & compliance
            'addressPublic',
            'ltoCrNumber', 'ltoOrNumber', 'insuranceProvider', 'insurancePolicyNumber',
            'franchisePermit', 'gpsTrackerId',
            // Photos & legal terms
            'photoUrl', 'interiorPhotoUrl', 'frontPhotoUrl', 'backPhotoUrl',
            'extraPhotos', 'contractType', 'contractTerms', 'legalTerms',
            'termsPreset', 'termsTitle', 'termsContent', 'requireRenteeSignature',
            // Driver options
            'offersDriver', 'driverDailyPrice', 'driverNote', 'driverLicenseNumber',
            // Trip & rentee fields
            'renteeId', 'renteeName', 'renteePhotoUrl', 
            'renteePhone', 'renteeRating', 'startEpoch', 'endEpoch', 'expectedReturnEpoch', 
            'deliveryType', 'deliveryAddress', 'deliveryFee', 'currentLocationLat', 
            'currentLocationLng', 'fuelLevel', 'odoMeter', 'pickupPhotos', 
            'dropoffPhotos', 'hostRated', 'renteeRated',
            // Booking acceptance & contract metadata
            'rentalDurationType', 'rentalMultiplier', 'startDate', 'endDate', 
            'totalCost', 'bookingFee', 'renteeSignatureName', 'renteeLicenseNumber', 
            'signedAt', 'trackingLat', 'trackingLng', 'hireWithDriver', 'rentalType', 
            'currentRequestId', 'allowChat', 'verificationSelfieUrl', 
            'verificationGovtIdUrl', 'verificationStatus', 'hostIsVerified', 
            'hostVerificationStatus', 'hostVerificationTier', 'renteeIsVerified', 
            'renteeVerificationStatus', 'renteeVerificationTier',
            // Listing deletion & archival
            'isDeleted', 'deletedAt'
          ])
        ) ||
        // 1b. Host: When awaiting signature, can revoke approval (back to Available) or activate lease
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          (resource.data.status == 'Awaiting Signature' || resource.data.status == 'awaiting signature') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'renteeId', 'renteeName', 'renteePhotoUrl', 'startDate', 
            'endDate', 'totalCost', 'bookingFee', 'currentRequestId', 
            'renteeSignatureName', 'signedAt', 'allowChat'
          ])
        ) ||
        // 1c. Host: When vehicle is active/booked, can submit rating, accept extensions, update tracking, or complete/reset rental
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          resource.data.status != 'Available' && resource.data.status != 'available' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'hostRated', 'endDate', 'totalCost', 'status', 'trackingLat', 'trackingLng',
            'renteeId', 'renteeName', 'renteePhotoUrl', 'rentalDurationType', 'rentalMultiplier',
            'startDate', 'bookingFee', 'renteeSignatureName', 'renteeLicenseNumber', 'signedAt',
            'currentRequestId', 'allowChat'
          ])
        ) ||
        // 2a. Assigned Rentee: Can sign contract when status is Awaiting Signature
        (isActiveUser() && 
          ((resource.data.status == 'Awaiting Signature' || resource.data.status == 'awaiting signature') &&
           (('renteeId' in resource.data && resource.data.renteeId == request.auth.uid) ||
            ('renterId' in resource.data && resource.data.renterId == request.auth.uid) ||
            ('currentRequestId' in resource.data))) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'renteeSignatureName', 'signedAt', 'signatureHash', 
            'currentRequestId', 'renteeLicenseNumber'
          ])
        ) ||
        // 2b. Assigned Rentee: When active, can update trip status, return info, location, extensions & rating
        (isActiveUser() && 
          (('renteeId' in resource.data && resource.data.renteeId == request.auth.uid) ||
           ('renterId' in resource.data && resource.data.renterId == request.auth.uid)) && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'fuelLevel', 
            'odoMeter', 'dropoffPhotos', 'renteeRated', 'endDate', 'totalCost'
          ])
        ) ||
        // 3. Admin / Staff
        isAdminOrStaff()
      );

      match /private/{docId} {
        allow read: if isAuthenticated() && docId == 'location' && !isPartnerToken();
        allow create, update: if isActiveUser() && docId == 'location' && (
          get(/databases/$(database)/documents/rentals/$(rentalId)).data.hostId == request.auth.uid ||
          get(/databases/$(database)/documents/rentals/$(rentalId)).data.renteeId == request.auth.uid
        );
        allow delete: if false;
      }

      allow delete: if (isActiveUser() && resource.data.hostId == request.auth.uid && (resource.data.status == 'Available' || resource.data.status == 'available')) || isAdminOrStaff();

      match /questions/{questionId} {
        allow read: if !isPartnerToken();
        allow write: if isActiveUser() && !isPartnerToken();
      }

      match /qna/{qnaId} {
        allow read: if !isPartnerToken();
        allow write: if (isActiveUser() && !isPartnerToken()) || isAdminOrStaff();
      }
    }

    // Rental Requests Collection
    // Booking request guard (rental_requests / property_requests). The bookingRequest callable creates these docs
    // (Admin SDK) and bookingAction settles the money from the escrow doc, but it also reads this doc's `status`.
    // A party who could write any status could therefore park a funded booking in a closed state and block the refund
    // or payout. Clients may only: be a party; leave the identity / money fields alone; do the legitimate
    // transitions (host Pending->Approved, renter ->Booked once approved); and write a closing status
    // (Rejected / Cancelled / Completed / Refunded) only while NO escrow is held (legacy no-escrow requests).
    // Writes that leave `status` unchanged (e.g. echoing what the callable just set) stay allowed.
    function requestPartyUpdateOk(escrowPath) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      let uid = request.auth.uid;
      let isHost = before.get('hostId', '') == uid;
      let isRentee = before.get('renteeId', '') == uid || before.get('renterId', '') == uid;
      let closing = ['Rejected', 'Cancelled', 'Completed', 'Refunded'];
      let escrowHeld = exists(escrowPath) && get(escrowPath).data.get('status', '') == 'Held';
      return (isHost || isRentee)
        && !changed.hasAny(['renteeId', 'renterId', 'hostId', 'bookingFee', 'discountAmount', 'promoCode',
                            'securityDepositAmount', 'baseRentAmount', 'hostCommissionRate', 'customerPlatformFeeAmount',
                            'customerPlatformFeeRate', 'totalCustomerPaid', 'escrowStatus', 'refundAmount', 'createdAt'])
        && (!changed.hasAny(['status']) || (
          (after.status == 'Approved' && isHost && before.status == 'Pending') ||
          (after.status == 'Booked' && isRentee && before.status in ['Approved', 'Awaiting Signature']) ||
          (after.status in closing && !escrowHeld && !(before.status in closing)) ||
          (!(after.status in closing) && !(after.status in ['Pending', 'Approved', 'Booked']) && !(before.status in closing))
        ));
    }

    match /rental_requests/{requestId} {
      // Participants (host, renter, or the rentee/renterId/uid aliases) and claim staff only.
      // A rentalId-only list is not a party constraint, so strangers cannot read a listing's requests.
      // Public listing docs stay on /rentals. Collection-group queries have no separate allow.
      allow read: if isClaimStaff() || (resource != null && isBookingRequestParty(resource.data)) || (resource != null && partnerCoversArea(resource.data.get('areaKey', '')));
      // Created / deleted only by the bookingRequest callable (Admin SDK) or staff.
      allow create, delete: if isAdminOrStaff();
      allow update: if (isActiveUser() && requestPartyUpdateOk(/databases/$(database)/documents/rental_escrows/$(requestId))) || isAdminOrStaff();
    }

    // Rental Extensions Collection
    match /rental_extensions/{extId} {
      allow read: if isAuthenticated() && !isPartnerToken();
      allow write: if (isActiveUser() && !isPartnerToken()) || isAdminOrStaff();
    }

    // Rental History Collection
    match /rental_history/{historyId} {
      allow read: if isAuthenticated() && !isPartnerToken();
      allow write: if (isActiveUser() && !isPartnerToken()) || isAdminOrStaff();
    }

    // Rental Escrows Collection (Dual-field support for renteeId & renterId)
    match /rental_escrows/{rentalId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        isRentalEscrowParty(resource.data) || 
        isAdminOrStaff()
      );
      // Phase 4: escrow docs hold real money. Only the bookingRequest / bookingAction / rentalExtension
      // callables (Admin SDK) write them; clients and parties can only read.
      allow create, delete: if false;
      allow update: if clientEscrowUpdateOk();
    }

    // Rental Extension Escrows Collection
    match /rental_extension_escrows/{extensionId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        isRentalEscrowParty(resource.data) || 
        isAdminOrStaff()
      );
      // Phase 4: escrow docs hold real money. Only the bookingRequest / bookingAction / rentalExtension
      // callables (Admin SDK) write them; clients and parties can only read.
      allow create, delete: if false;
      allow update: if clientEscrowUpdateOk();
    }

    // Rental Contracts Collection (Permanent immutable contract snapshots)
    match /rental_contracts/{contractId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        isRentalEscrowParty(resource.data) || 
        isAdminOrStaff()
      );
      allow create: if isActiveUser() && (
        isRentalEscrowParty(request.resource.data) || 
        isAdminOrStaff()
      );
      allow update, delete: if isAdminOrStaff();
    }

