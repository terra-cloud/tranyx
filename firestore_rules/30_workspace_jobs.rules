    // ------------------------------------------------------------------------
    // WORKSPACE: JOBS, APPLICATIONS, ESCROWS & REPUTATION
    // ------------------------------------------------------------------------

    // Non-admin job updates, one branch per action (see allow update in /jobs).
    function isJobParticipantUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      let isCreator = before.creatorId == request.auth.uid;
      let isWorker = before.get('acceptedApplicantId', null) == request.auth.uid;
      let openOrReviewing = before.status in ['Open', 'open', 'Reviewing', 'reviewing'];
      let unassigned = before.get('acceptedApplicantId', null) == null || before.acceptedApplicantId == '';
      return
        // 1. Creator (Employer): Can update listing details ONLY when job status is Open or Reviewing
        (isCreator && openOrReviewing && unassigned && changed.hasOnly([
          'id', 'title', 'description', 'category', 'categoryGroup', 'employmentType',
          'dateRequirement', 'jobDate', 'timePreference', 'pricingType', 'pricingValue',
          'locationType', 'address', 'landmark', 'status', 'applicantCount',
          'recentApplicantPhotos', 'applicantUids', 'pickupAddress', 'pickupLat',
          'pickupLng', 'destinationAddress', 'destinationLat', 'destinationLng',
          'hasTracker', 'hasInspectionHoldback', 'imageUrls', 'acceptedApplicantId',
          'acceptedApplicantName', 'completionCode', 'receiptUrl', 'employerRated',
          'nyxianRated', 'promoCode', 'discountAmount', 'creatorPhotoUrl',
          'creatorName', 'creatorType', 'createdAt', 'updatedAt',
          'acknowledgmentDeadline', 'acknowledgmentSlaMinutes', 'acknowledgmentCategory',
          'acknowledgmentStatus', 'acknowledgedAt', 'hiredAt', 'acknowledgmentReminderSent'
        ])) ||
        // 1b. Creator (Employer): Resetting, re-opening or cancelling an unacknowledged or expired job
        (isCreator &&
          before.status in ['Awaiting Acknowledgment', 'awaiting acknowledgment', 'Acknowledgment Expired', 'acknowledgment expired'] &&
          changed.hasOnly([
            'status', 'acceptedApplicantId', 'acceptedApplicantName', 'updatedAt',
            'acknowledgmentDeadline', 'acknowledgmentSlaMinutes', 'acknowledgmentCategory',
            'acknowledgmentStatus', 'acknowledgedAt', 'hiredAt', 'acknowledgmentReminderSent'
          ])) ||
        // 1c. Creator (Employer): When job is completed/active, can ONLY submit employer rating
        (isCreator && before.status != 'Open' && before.status != 'open' && changed.hasOnly(['employerRated'])) ||
        // 1d. Creator (Employer): Reclaiming an inactive/stalled job and marking it Abandoned
        (isCreator && after.status in ['Abandoned', 'abandoned'] &&
          changed.hasOnly(['status', 'abandonedAt', 'abandonReason', 'updatedAt'])) ||
        // 1e. Active Participants: Raising a dispute for admin arbitration
        ((isCreator || isWorker) && after.status in ['Disputed', 'disputed'] &&
          changed.hasOnly(['status', 'disputeId', 'disputedAt', 'disputedBy', 'updatedAt'])) ||
        // Active participants can touch lastActivityAt
        ((isCreator || isWorker) && changed.hasOnly(['lastActivityAt'])) ||
        // 2. Assigned Nyxian (Freelancer): Can update work progress, status & completion fields
        (isWorker &&
          (!changed.hasAny(['status']) || after.status == before.status ||
            (after.status in ['In Progress', 'in progress', 'arrived_pickup', 'paid_cashier',
                             'in_transit', 'arrived_dropoff', 'Done', 'done', 'Completed', 'completed'] &&
             before.status in ['Awaiting Acknowledgment', 'awaiting acknowledgment',
                            'In Progress', 'in progress', 'arrived_pickup', 'paid_cashier',
                            'in_transit', 'arrived_dropoff', 'Done', 'done'])) &&
          changed.hasOnly(['status', 'completionCode', 'receiptUrl', 'nyxianRated',
                           'acknowledgedAt', 'acknowledgmentStatus', 'updatedAt'])) ||
        // 2b. SLA Expiration or Reminder update by active participants
        ((isCreator || isWorker) && before.status in ['Awaiting Acknowledgment', 'awaiting acknowledgment'] &&
          changed.hasOnly(['status', 'acknowledgmentStatus', 'acknowledgmentReminderSent', 'updatedAt'])) ||
        // 3. Any Active Applicant: Can apply to or withdraw from an Open/Reviewing job
        (openOrReviewing && unassigned &&
          changed.hasOnly(['applicantCount', 'applicantUids', 'recentApplicantPhotos']));
    }

    // Jobs Collection (Anti-Exploitation: Employer CANNOT alter terms once hired)
    match /jobs/{jobId} {
      allow read: if true; // Publicly browse jobs
      allow create: if isActiveUser() && request.resource.data.creatorId == request.auth.uid;
      
      // Update: same per-action conditions as before, but evaluated in ONE function so the shared
      // values (diff, caller role, status) are computed once. Denied writes used to run every allow
      // separately and hit the 1,000-expression limit; behaviour is unchanged.
      allow update: if isJobParticipantUpdate() && isActiveUser();
      // 4. Admin / Staff
      allow update: if isAdminOrStaff();

      allow delete: if (isActiveUser() && resource.data.creatorId == request.auth.uid && (
        resource.data.status == 'Open' || 
        resource.data.status == 'open' || 
        resource.data.status == 'Cancelled' || 
        resource.data.status == 'cancelled'
      )) || isAdminOrStaff();

      // Subcollection: Applications
      match /applications/{applicantId} {
        allow read: if isAuthenticated();
        allow create, update: if (
          (isActiveUser() && (
            request.auth.uid == applicantId ||
            (resource != null && (resource.data.applicantId == request.auth.uid || resource.data.applicantUid == request.auth.uid)) ||
            get(/databases/$(database)/documents/jobs/$(jobId)).data.creatorId == request.auth.uid
          )) ||
          isAdminOrStaff()
        ) && (
          // Standard rate bids
          request.resource.data.isCounterOffer != true ||
          // Counter offers: strictly positive (> 0) and restricted to 80% - 150% of the job's pricingValue
          (
            request.resource.data.proposalRate is number &&
            request.resource.data.proposalRate > 0 &&
            get(/databases/$(database)/documents/jobs/$(jobId)).data.pricingValue is number &&
            get(/databases/$(database)/documents/jobs/$(jobId)).data.pricingValue > 0 &&
            request.resource.data.proposalRate >= (get(/databases/$(database)/documents/jobs/$(jobId)).data.pricingValue * 0.8) - 0.01 &&
            request.resource.data.proposalRate <= (get(/databases/$(database)/documents/jobs/$(jobId)).data.pricingValue * 1.5) + 0.01
          )
        );
        allow delete: if (isActiveUser() && (
          request.auth.uid == applicantId ||
          (resource != null && (resource.data.applicantId == request.auth.uid || resource.data.applicantUid == request.auth.uid))
        )) || isAdminOrStaff();
      }

      // Subcollection: Messages (Job chat room)
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow write: if isActiveUser() || isAdminOrStaff();
      }

      // Subcollection: Questions (Public Q&A)
      match /questions/{questionId} {
        allow read: if true;
        allow write: if isActiveUser();
      }

      // Subcollection: QnA (Public Q&A alternative path)
      match /qna/{qnaId} {
        allow read: if true;
        allow write: if isActiveUser() || isAdminOrStaff();
      }
    }

    // Job Escrow Collection
    match /escrow/{jobId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.creatorId == request.auth.uid || 
        resource.data.employerId == request.auth.uid || 
        resource.data.workerId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow create: if isActiveUser() && (
        request.resource.data.employerId == request.auth.uid || 
        request.resource.data.creatorId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow update: if isActiveUser() && (
        resource.data.employerId == request.auth.uid || 
        resource.data.creatorId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow delete: if (isActiveUser() && (
        resource.data.employerId == request.auth.uid || 
        resource.data.creatorId == request.auth.uid ||
        (exists(/databases/$(database)/documents/jobs/$(jobId)) && 
         get(/databases/$(database)/documents/jobs/$(jobId)).data.acceptedApplicantId == request.auth.uid)
      )) || isAdminOrStaff();
    }

    // Escrow Holdbacks Collection
    match /escrow_holdbacks/{holdbackId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.employerId == request.auth.uid || isAdminOrStaff());
      allow create, update: if isActiveUser() && (request.resource.data.uid == request.auth.uid || request.resource.data.employerId == request.auth.uid || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }

    // Job Cancellation Audit Logs Collection
    match /job_cancellation_logs/{logId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.cancelledBy == request.auth.uid ||
        isAdminOrStaff()
      );
      allow create: if isActiveUser() && (
        request.resource.data.cancelledBy == request.auth.uid ||
        isAdminOrStaff()
      );
      allow update, delete: if isAdminOrStaff();
    }
