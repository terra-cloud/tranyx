    // ------------------------------------------------------------------------
    // WORKSPACE: PROPERTY RENTALS, LEASES & CONTRACT DOCUMENTS
    // ------------------------------------------------------------------------

    // Properties Collection (Anti-Exploitation: Host CANNOT alter pricing/rules once booked)
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.hostId == request.auth.uid;
      
      allow update: if 
        // 1. Host (Property Owner): Can update property details & accept bookings when not actively rented
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          request.resource.data.hostId == resource.data.hostId &&
          (resource.data.status == 'Available' || resource.data.status == 'available' || resource.data.status == 'Not Accepting Bookings') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            // Identity & metadata
            'id', 'hostName', 'hostPhotoUrl', 'title', 'type', 'category',
            'propertyType', 'description', 'status', 'acceptingBookings',
            'isListingFeeWaived', 'createdAt', 'updatedAt',
            // Pricing & deposit
            'pricePerMonth', 'priceMonthly', 'priceWeekly', 'priceDaily',
            'nightlyPrice', 'weeklyDiscount', 'monthlyDiscount', 'cleaningFee',
            'allowedDurations', 'depositMonths', 'depositAmount',
            'securityDepositAmount', 'advanceAmount', 'depositType',
            'depositValue', 'securityDepositPolicy',
            // Location & specs
            'address', 'location', 'landmark', 'lat', 'lng', 'latitude', 'longitude',
            'bedrooms', 'bathrooms', 'maxGuests', 'sqft', 'furnishing',
            'amenities', 'houseRules',
            // Photos & legal terms
            'photoUrl', 'photoUrls', 'images', 'contractType', 'contractTerms',
            'legalTerms', 'termsPreset', 'termsTitle', 'termsContent',
            'requireRenteeSignature',
            // Lease & rentee fields
            'renteeId', 'renteeName', 'renteePhotoUrl', 'checkInDate', 
            'checkOutDate', 'hostRated', 'renteeRated',
            // Booking acceptance & lease metadata
            'rentalDurationType', 'rentalMultiplier', 'startDate', 'endDate', 
            'totalCost', 'baseRentAmount', 'bookingFee', 
            'customerPlatformFeeRate', 'hostCommissionRate', 'renteeSignatureName', 
            'signedAt', 'currentRequestId', 'allowChat', 'licenseNumber', 
            'verificationSelfieUrl', 'verificationGovtIdUrl', 'verificationStatus', 
            'hostIsVerified', 'hostVerificationStatus', 'hostVerificationTier', 
            'renteeIsVerified', 'renteeVerificationStatus', 'renteeVerificationTier',
            // Listing deletion & archival
            'isDeleted', 'deletedAt'
          ])
        ) ||
        // 1b. Host: When awaiting signature, can revoke approval (back to Available) or activate lease
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          (resource.data.status == 'Awaiting Signature' || resource.data.status == 'awaiting signature') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'renteeId', 'renteeName', 'renteePhotoUrl', 'rentalDurationType', 
            'rentalMultiplier', 'startDate', 'endDate', 'checkInDate', 'checkOutDate', 
            'totalCost', 'baseRentAmount', 'securityDepositAmount', 'bookingFee', 
            'currentRequestId', 'renteeSignatureName', 'signedAt', 'licenseNumber', 'allowChat'
          ])
        ) ||
        // 1c. Host: When property is active/booked, can submit rating, accept extensions, or update status
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          resource.data.status != 'Available' && resource.data.status != 'available' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'hostRated', 'endDate', 'checkOutDate', 'totalCost', 'status'
          ])
        ) ||
        // 2a. Assigned Rentee: Can sign contract when status is Awaiting Signature
        (isActiveUser() && 
          ((resource.data.status == 'Awaiting Signature' || resource.data.status == 'awaiting signature') &&
           (('renteeId' in resource.data && resource.data.renteeId == request.auth.uid) ||
            ('renterId' in resource.data && resource.data.renterId == request.auth.uid) ||
            ('currentRequestId' in resource.data))) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'renteeSignatureName', 'signedAt', 'signatureHash', 
            'currentRequestId', 'licenseNumber'
          ])
        ) ||
        // 2b. Assigned Rentee: When active, can update booking status, extensions & guest rating
        (isActiveUser() && 
          (('renteeId' in resource.data && resource.data.renteeId == request.auth.uid) ||
           ('renterId' in resource.data && resource.data.renterId == request.auth.uid)) && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'renteeRated', 'endDate', 'checkOutDate', 'totalCost'
          ])
        ) ||
        // 3. Admin / Staff
        isAdminOrStaff();

      allow delete: if (isActiveUser() && resource.data.hostId == request.auth.uid && (resource.data.status == 'Available' || resource.data.status == 'available')) || isAdminOrStaff();

      match /questions/{questionId} {
        allow read: if true;
        allow write: if isActiveUser();
      }

      match /qna/{qnaId} {
        allow read: if true;
        allow write: if isActiveUser() || isAdminOrStaff();
      }
    }

    // Property Requests Collection
    match /property_requests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() || isAdminOrStaff();
    }

    // Property Escrows Collection (Dual-field support for renteeId & renterId)
    match /property_escrows/{requestId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        isRentalEscrowParty(resource.data) || 
        isAdminOrStaff()
      );
      allow create, update: if isActiveUser() && (
        isRentalEscrowParty(request.resource.data) || 
        isAdminOrStaff()
      );
      allow delete: if (isActiveUser() && isRentalEscrowParty(resource.data)) || isAdminOrStaff();
    }

    // Property History Collection
    match /property_history/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() || isAdminOrStaff();
    }

    // Contract Documents Collection (Custom Contract PDFs & Metadata)
    match /contract_documents/{docId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.hostId == request.auth.uid;
      allow update: if isActiveUser() && (resource.data.hostId == request.auth.uid || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }
