    // ------------------------------------------------------------------------
    // WORKSPACE: CHATS, COMMUNICATIONS, SUPPORT TICKETS & NOTIFICATIONS
    // ------------------------------------------------------------------------

    // Notifications Collection
    match /notifications/{notifId} {
      allow read, update, delete: if resource == null || !('uid' in resource.data) || resource.data.uid == request.auth.uid || isAdminOrStaff() || isAuthenticated();
      allow create: if isActiveUser() || isAuthenticated() || isAdminOrStaff();
    }

    // Direct Chats Collection
    match /chats/{chatId} {
      function isChatParticipant() {
        return (resource != null && 'userIds' in resource.data && request.auth.uid in resource.data.userIds) ||
               (request.resource != null && 'userIds' in request.resource.data && request.auth.uid in request.resource.data.userIds) ||
               chatId.matches('^rental_[^_]+_' + request.auth.uid + '$') ||
               chatId.matches('^property_[^_]+_' + request.auth.uid + '$') ||
               chatId.matches('^support_' + request.auth.uid + '$') ||
               chatId.matches('^job_[^_]+_' + request.auth.uid + '$') ||
               chatId.matches('^' + request.auth.uid + '_.*');
      }

      allow read: if isAdminOrStaff() || (isActiveUser() && isChatParticipant());
      allow write: if isAdminOrStaff() || (isActiveUser() && isChatParticipant());

      match /messages/{messageId} {
        allow read: if isAdminOrStaff() || (isActiveUser() && (
          isChatParticipant() ||
          (resource != null && resource.data.senderId == request.auth.uid)
        ));
        allow write: if isAdminOrStaff() || (isActiveUser() && (
          isChatParticipant() ||
          request.resource.data.senderId == request.auth.uid
        ));
      }
    }

    // Support Chats Collection
    match /support_chats/{chatId} {
      allow read, write: if isActiveUser() || isAdminOrStaff();
      match /messages/{messageId} {
        allow read, write: if isActiveUser() || isAdminOrStaff();
      }
    }

    // Support Tickets Collections (Cross-platform compatibility)
    match /supportTickets/{ticketId} {
      allow read, write: if isActiveUser() || isAdminOrStaff();
      match /responses/{responseId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /support_tickets/{ticketId} {
      allow read, write: if isActiveUser() || isAdminOrStaff();
      match /responses/{responseId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /tickets/{ticketId} {
      allow read, write: if isAuthenticated();
    }

    // Disputes Collection (Review and resolution portal)
    match /disputes/{disputeId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.openedBy == request.auth.uid ||
        resource.data.employerId == request.auth.uid ||
        resource.data.acceptedNyxianId == request.auth.uid ||
        isAdminOrStaff()
      );
      allow create: if isActiveUser() && (
        request.resource.data.openedBy == request.auth.uid ||
        isAdminOrStaff()
      ) && (request.resource.data.status == 'OPEN' || request.resource.data.status == 'open');
      allow update: if isAdminOrStaff() || (
        isActiveUser() && (
          resource.data.openedBy == request.auth.uid ||
          resource.data.employerId == request.auth.uid ||
          resource.data.acceptedNyxianId == request.auth.uid
        ) &&
        // Non-admin participants CANNOT alter dispute resolution or status to RESOLVED
        request.resource.data.status == resource.data.status &&
        !('resolutionPathway' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('resolvedAt' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('resolvedBy' in request.resource.data.diff(resource.data).affectedKeys())
      );
      allow delete: if isAdminOrStaff();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }

      match /notes/{noteId} {
        allow read, write: if isAdminOrStaff();
      }
    }
