    // ------------------------------------------------------------------------
    // ADMIN PORTAL OPERATIONS, P2P DESK & SYSTEM CONFIGURATION
    // ------------------------------------------------------------------------

    // P2P Agents Collection. Public read of QR credentials. Creating or editing an agent is an admin claim,
    // not a users-doc flag and not an existing agent document.
    match /p2p_agents/{agentId} {
      allow read: if !isPartnerToken();
      allow write: if isClaimAdmin();
    }

    // Unified Requests Collection (Admin Portal: Enforces 3-Min Claim Limit & Single-Agent Lock)
    match /requests/{requestId} {
      allow read: if isAuthenticated() && !isPartnerToken();
      allow create: if isAuthenticated() && !isPartnerToken();
      allow delete: if isAdminOrStaff();
      
      allow update: if isAuthenticated() && !isPartnerToken() && (
        isAdminOrStaff() ||
        // 1. Agent accepting their assignment WITHIN 3 minutes
        (
          resource.data.status == 'ASSIGNED' && 
          (resource.data.assignedTo == request.auth.uid || resource.data.assignedAgentId == request.auth.uid) &&
          (resource.data.claimDeadline == null || request.time < resource.data.claimDeadline)
        ) ||
        // 2. Any agent taking a request whose claimDeadline HAS PASSED
        (
          resource.data.status == 'ASSIGNED' && 
          resource.data.claimDeadline != null &&
          request.time > resource.data.claimDeadline
        ) ||
        // 3. Claiming an unassigned pending request
        (
          (resource.data.status == 'PENDING' || resource.data.status == 'OPEN') && 
          (resource.data.assignedTo == null || resource.data.assignedAgentId == null)
        ) ||
        // 4. Updating an active IN_PROGRESS request owned by self
        (
          (resource.data.status == 'IN_PROGRESS' || resource.data.status == 'In Progress') && 
          (resource.data.assignedTo == request.auth.uid || resource.data.assignedAgentId == request.auth.uid)
        )
      );
    }

    // Email & Mail Logging Collections
    // KAN-143: mail/emails are written only by the admin panel (ticket_email_service) and read by the mail
    // extension (Admin SDK); no web/mobile client touches them, so signed-in users cannot relay or read mail.
    match /mail/{mailId} {
      allow read, write: if isAdminOrStaff();
    }
    match /emails/{mailId} {
      allow read, write: if isAdminOrStaff();
    }

    // Audit Logs Collections (KAN-143: no client writes them; the admin panel uses admin_audit_logs)
    match /audit_logs/{logId} {
      allow read, write: if isAdminOrStaff();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdminOrStaff();
    }

    match /admin_audit_logs/{logId} {
      allow read, write: if isAdminOrStaff();
    }

    match /system_logs/{logId} {
      allow read, write: if isAdminOrStaff();
    }

    // System Config Collection (Treasury keys and backend config - Admin only!)
    match /system_config/{docId} {
      allow read, write: if isClaimAdmin();
    }
    match /system_config/{docId}/{subPath=**} {
      allow read, write: if isClaimAdmin();
    }

    // Config Collection. Clients only read config/app_config; third-party API docs (e.g. config/imgbb) are admin only.
    match /config/{docId} {
      allow read: if isClaimAdmin() || (isAuthenticated() && !isPartnerToken() && docId == 'app_config');
      allow write: if isClaimAdmin();
    }

    // Platform Fees Collection (Admin managed). Client creates stay Function-only (KAN-136-P1 / D10).
    match /platform_fees/{feeId} {
      allow read: if isAuthenticated() && !isPartnerToken();
      allow write: if isClaimAdmin();
    }

    // settings/platform_fees: the fee rates the web/mobile apps read before showing a gig/booking total.
    // Everything else under settings stays closed. Writes are admin/staff only (the server reads it with the Admin SDK).
    // Audit trail of staffOps: Admin SDK writes only. Read is an admin custom claim, not an agent or a users-doc flag.
    match /staff_audit_log/{opId} {
      allow read: if isClaimAdmin();
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if isAuthenticated() && !isPartnerToken() && docId == 'platform_fees';
      allow write: if isAdminOrStaff();
    }

    // Platform Config Collection (Job SLAs, Platform Settings - Admin managed)
    match /platform_config/{docId} {
      allow read: if isAuthenticated() && !isPartnerToken();
      allow write: if isClaimAdmin();
    }
    match /platform_config/{docId}/{subPath=**} {
      allow read: if isAuthenticated() && !isPartnerToken();
      allow write: if isClaimAdmin();
    }

    // Promos Collection
    match /promos/{promoId} {
      allow read: if isAuthenticated() && !isPartnerToken();
      allow create, delete: if isAdminOrStaff();
      allow update: if isAdminOrStaff() || 
        (isActiveUser() && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'usedBy']));
    }

    // Promo Audit Trail Collection
    match /promo_audit_trail/{auditId} {
      allow read, write: if isAdminOrStaff();
    }

    // News & Promotions Collections
    match /news_posts/{postId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    // KYC Submissions Collection
    match /kyc_submissions/{submissionId} {
      allow read: if isAuthenticated() && (request.auth.uid == submissionId || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow write: if (isActiveUser() && (request.auth.uid == submissionId)) || isAdminOrStaff();
    }

    // Agent & Staff Realtime Presence Collection
    match /presence/{agentId} {
      allow read: if !isPartnerToken();
      allow write: if isAuthenticated() && !isPartnerToken() && (isOwner(agentId) || isAdminOrStaff());
    }

    // City Partner License (TRAD-15). Clients never write these. Partners read only their own rows.
    match /partners/{partnerId} {
      allow read: if isClaimAdmin() || (isActivePartner() && partnerId == request.auth.token.partnerId);
      allow write: if false;
    }

    match /area_assignments/{areaKey} {
      allow read: if isClaimAdmin();
      allow write: if false;
    }

    match /partner_audit_log/{entryId} {
      allow read: if isClaimAdmin() || (isActivePartner() && resource.data.get('partnerId', '') == request.auth.token.partnerId);
      allow write: if false;
    }

    match /area_revenue/{entryId} {
      allow read: if isClaimAdmin() || (resource != null && partnerCoversArea(resource.data.get('areaKey', '')));
      allow write: if false;
    }

    match /area_revenue_index/{entryId} {
      allow read, write: if false;
    }

    match /partner_statements/{statementId} {
      allow read: if isClaimAdmin() || (isActivePartner() && resource.data.get('partnerId', '') == request.auth.token.partnerId);
      allow write: if false;
    }

    match /partner_payouts/{payoutId} {
      allow read: if isClaimAdmin() || (isActivePartner() && resource.data.get('partnerId', '') == request.auth.token.partnerId);
      allow write: if false;
    }

    match /partner_config/{docId} {
      allow read: if isClaimAdmin();
      allow write: if false;
    }

