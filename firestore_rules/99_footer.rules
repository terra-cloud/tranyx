    // ------------------------------------------------------------------------
    // COLLECTION GROUP QUERIES & ROOT CLOSING
    // ------------------------------------------------------------------------

    match /{path=**}/applications/{applicantId} {
      allow read: if (isActiveUser() && !isPartnerToken()) || isAdminOrStaff();
    }

    match /{path=**}/questions/{questionId} {
      allow read: if !isPartnerToken();
      allow write: if isActiveUser() && !isPartnerToken();
    }

    match /{path=**}/qna/{qnaId} {
      allow read: if !isPartnerToken();
      allow write: if ((isActiveUser() && !isPartnerToken()) || isAdminOrStaff());
    }
  }
}
