# Uncomment this line to define a global platform for your project
# platform :ios, '26.0'


# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug-dev' => :debug,
  'Profile-dev' => :release,
  'Release-dev' => :release,
  'Debug-uat' => :debug,
  'Profile-uat' => :release,
  'Release-uat' => :release,
  'Debug-production' => :debug,
  'Profile-production' => :release,
  'Release-production' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '26.0'
      config.build_settings['GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS'] = 'NO'
      config.build_settings['CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS'] = 'NO'
      config.build_settings['OTHER_CFLAGS'] ||= ['$(inherited)']
      config.build_settings['OTHER_CFLAGS'] << '-Wno-deprecated-declarations'
      config.build_settings['OTHER_CFLAGS'] << '-Wno-error=deprecated-declarations'
      config.build_settings['OTHER_CFLAGS'] << '-Wno-obsolete-declarations'
    end
  end

  # Patch legacy ALAsset usage in flutter_image_compress_common for iOS 26+ SDK compatibility
  symetadata_m = File.expand_path('../.symlinks/plugins/flutter_image_compress_common/ios/Classes/SYPictureMetadata/SYMetadata.m', __FILE__)
  if File.exist?(symetadata_m)
    text = File.read(symetadata_m)
    text.gsub!(/\+ \(instancetype\)metadataWithAsset:[\s\S]*?\n\}/, '+ (instancetype)metadataWithAsset:(id)asset { return nil; }')
    text.gsub!(/\+ \(NSDictionary \*\)dictionaryWithAssetURL:[\s\S]*?\n\}/, '+ (NSDictionary *)dictionaryWithAssetURL:(NSURL *)assetURL { return nil; }')
    File.write(symetadata_m, text)
  end

  symetadata_h = File.expand_path('../.symlinks/plugins/flutter_image_compress_common/ios/Classes/SYPictureMetadata/SYMetadata.h', __FILE__)
  if File.exist?(symetadata_h)
    text = File.read(symetadata_h)
    text.gsub!(/@class ALAsset;/, '//@class ALAsset;')
    text.gsub!(/\+ \(instancetype\)metadataWithAsset:([^\n;]*);/, '+ (instancetype)metadataWithAsset:(id)asset;')
    text.gsub!(/\+ \(instancetype\)metadataWithAssetURL:([^\n;]*);/, '+ (instancetype)metadataWithAssetURL:(NSURL *)assetURL;')
    text.gsub!(/\+ \(NSDictionary \*\)dictionaryWithAssetURL:([^\n;]*);/, '+ (NSDictionary *)dictionaryWithAssetURL:(NSURL *)assetURL;')
    File.write(symetadata_h, text)
  end
end
